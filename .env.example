TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_key_secret
TWILIO_PHONE_NUMBER=+15551234567
# Optional. Uncomment only if you have a configured WhatsApp sender.
# TWILIO_WHATSAPP_NUMBER=whatsapp:+15551234567
TWILIO_VOICE_PUBLIC_DOMAIN=your-app.ngrok.app
TWILIO_SERVER_HOST=0.0.0.0
TWILIO_SERVER_PORT=8000

# RCS - optional. Leave commented out if you don't have an RCS sender provisioned.
# Format: rcs:<sender-id-or-phone>, for example rcs:+15551234567
# TWILIO_RCS_SENDER_ID=rcs:+15551234567

# Filled in after running: npm run setup
TWILIO_MEMORY_STORE_ID=
TWILIO_CONVERSATION_CONFIGURATION_ID=
TWILIO_INTELLIGENCE_CONFIGURATION_ID=

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Email (SendGrid) — not handled by TAC, used separately
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=you@yourdomain.com